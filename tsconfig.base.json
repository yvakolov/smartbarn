{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@smartbarn/platform-core": ["libs/platform/core/src/index.ts"],
      "@smartbarn/platform-i18n": ["libs/platform/i18n/src/index.ts"],
      "@smartbarn/floor-field": ["libs/modules/floor-field/src/index.ts"],
      "@smartbarn/walls": ["libs/modules/walls/src/index.ts"],
      "@smartbarn/roof": ["libs/modules/roof/src/index.ts"],
      "@smartbarn/domain": ["libs/domain/src/index.ts"],
      "@smartbarn/2d-engine": ["libs/2d-engine/src/index.ts"],
      "@smartbarn/3d-engine": ["libs/3d-engine/src/index.ts"],
      "@smartbarn/bim-converter": ["libs/bim-converter/src/index.ts"],
      "@smartbarn/ui-ds": ["libs/ui/ds/src/index.ts"],
      "@smartbarn/ui-kit": ["libs/ui/kit/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
